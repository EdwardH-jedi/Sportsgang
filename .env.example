# =============================================================================
# Protin — local environment variables
#
# Copy this file to .env before starting local services:
#   cp .env.example .env          (bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# .env is loaded automatically by Docker Compose and by each app's own
# settings module. Never commit .env files.
# =============================================================================


# --- Docker Compose: PostgreSQL -----------------------------------------------
# These are used by the postgres container and must match POSTGRES_URL below.

POSTGRES_DB=protin
POSTGRES_USER=protin
POSTGRES_PASSWORD=protin

# Host port that PostgreSQL binds to. Change this if 5432 is already in use.
POSTGRES_PORT=5432


# --- Docker Compose: Redis ----------------------------------------------------
# Host port that Redis binds to. Change this if 6379 is already in use.

REDIS_PORT=6379


# --- API (apps/api) -----------------------------------------------------------
# These are also written to apps/api/.env for the FastAPI process.

APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Standard postgresql:// URL — the API derives the asyncpg:// variant from this.
POSTGRES_URL=postgresql://protin:protin@localhost:5432/protin
REDIS_URL=redis://localhost:6379/0

# JWT signing secret. Generate a strong value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-running


# --- Google OAuth (optional — needed for Calendar integration) ----------------
# Create credentials at https://console.cloud.google.com/
# Authorised redirect URI must include GOOGLE_REDIRECT_URI below.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/users/me/google-calendar/callback


# --- Worker -------------------------------------------------------------------
# How often (seconds) the notification worker polls for pending events.

WORKER_POLL_INTERVAL_SECONDS=60


# --- Mobile (apps/mobile) -----------------------------------------------------
# EXPO_PUBLIC_ prefix is required by Expo for variables exposed to the JS bundle.

EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:8000/users/me/google-calendar/callback

# Public URLs the in-app Privacy / Terms / Support links open. These are
# public URLs (not secrets) and safe to commit in this example file. They
# point at the SportsGang official website deployed on Netlify (the deployed
# Netlify hostname remains `sportgang.netlify.app` for v1; the public brand
# spelling is SportsGang — see docs/release/APP_STORE_METADATA.md)
# (served from `https://sportgang.netlify.app/`; the static site is maintained
# outside this repository's main branch). Production
# EAS builds must also have these set via `eas env:create` — see
# `docs/deployment/APPLE_TESTFLIGHT_PREP.md` §4.8.
EXPO_PUBLIC_PRIVACY_URL=https://sportgang.netlify.app/privacy/
EXPO_PUBLIC_TERMS_URL=https://sportgang.netlify.app/terms/
EXPO_PUBLIC_SUPPORT_URL=https://sportgang.netlify.app/support/
