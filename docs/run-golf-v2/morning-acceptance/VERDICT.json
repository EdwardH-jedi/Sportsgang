    },
    {
      "id": "MA-B",
      "investigation": "B",
      "severity": "P2",
      "status": "REPRODUCED_AT_CONTROLLED_TRANSPORT_BOUNDARY",
      "title": "Serial slow sockets extend contact authority; hanging close and cancellation skip remaining closures",
      "source": [
        "apps/api/app/services/chat.py:109-125",
        "apps/api/app/services/chat.py:137-162"
      ],
      "evidence": [
        "broadcast-total-time.json",
        "socket-close-stuck.json"
      ],
      "measured_seconds": {
        "one_socket": 5.0357678750297055,
        "three_sockets": 15.081020666984841
      },
      "acceptance_criteria": [
        "Document and enforce a total room deadline independent of connection count; <=7s is proposed probe budget, not current contract",
        "One/three/many stalled sockets plus failed/hanging closes finish within total deadline",
        "All send tasks cancelled and awaited before authority release; no post-block send invocation",
        "All closure attempts accounted for despite cancellation, registry cleanup cannot lose later sockets",
        "Real PostgreSQL block completes within bound plus measured DB overhead and original real-WebSocket ordering stays green"
      ],
      "limitations": [
        "Synthetic send_json backpressure/hanging close; no saturated kernel TCP or production incident reproduction",
        "Block closure runs after commit; hung close delays response/remaining closure, not already-committed pair lock"
      ]
    },
    {
      "id": "MA-A",
      "investigation": "A",
